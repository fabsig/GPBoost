search_space <- list("learning_rate" = c(0.001, 10),
                     "min_data_in_leaf" = c(1, 1000),
                     "max_depth" = c(-1, -1),
                     "num_leaves" = c(2, 2^10),
                     "lambda_l2" = c(0, 100),
                     "max_bin" = c(63, min(n,10000)),
                     "line_search_step_length" = c(TRUE, FALSE))
# Note: "max_depth" = c(-1, -1) means no depth limit as we tune 'num_leaves'.
