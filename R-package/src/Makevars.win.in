CXX_STD = @CXX_STD@

PKGROOT=.

LGB_CPPFLAGS = \
    @LGB_CPPFLAGS@ \
    -DUSE_SOCKET \
    -DLGB_R_BUILD

# CHOLMOD from SuiteSparse is bundled in SuiteSparse/, so that no external
# CHOLMOD or BLAS has to be found and linked. Its Partition (METIS) and CAMD
# interfaces and its MatrixOps and Modify modules are not included, NPRINT
# keeps it from writing to stdout, and GPB_SUITESPARSE_INTERNAL_BLAS routes
# its BLAS/LAPACK calls to the Eigen kernels in SuiteSparse/EigenBLAS.
CHOLMOD_CPPFLAGS = \
    -I$(PKGROOT)/SuiteSparse/SuiteSparse_config \
    -I$(PKGROOT)/SuiteSparse/AMD/Include \
    -I$(PKGROOT)/SuiteSparse/COLAMD/Include \
    -I$(PKGROOT)/SuiteSparse/CHOLMOD/Include \
    -DNPARTITION -DNCAMD -DNMATRIXOPS -DNMODIFY -DNPRINT \
    -DGPB_SUITESPARSE_INTERNAL_BLAS

PKG_CPPFLAGS = \
    -I$(PKGROOT)/include \
    $(CHOLMOD_CPPFLAGS) \
    $(LGB_CPPFLAGS)

PKG_CXXFLAGS = \
    ${SHLIB_OPENMP_CXXFLAGS} \
    ${SHLIB_PTHREAD_FLAGS}

PKG_LIBS = \
    ${SHLIB_OPENMP_CXXFLAGS} \
    ${SHLIB_PTHREAD_FLAGS} \
    -lws2_32 \
    -lIphlpapi

